# Groq — gere a chave em https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx

# Modelos (Groq). 70b = qualidade; 8b-instant = barato/rapido (routing usa os dois).
LLM_MODEL=llama-3.3-70b-versatile
CHEAP_MODEL=llama-3.1-8b-instant
PREMIUM_MODEL=llama-3.3-70b-versatile

# Embeddings LOCAIS (Groq nao tem endpoint de embeddings). Multilingue p/ PT-BR.
EMBED_MODEL=paraphrase-multilingual-MiniLM-L12-v2
HF_TOKEN=
# Observabilidade (opcional — banda "Excelente"). Veja docs/observability.md
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com
